rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function staff() {
      return signedIn() && request.auth.token.role in ['instructor', 'admin'];
    }

    function admin() {
      return signedIn() && request.auth.token.role == 'admin';
    }

    match /liveClasses/{classId} {
      allow read: if signedIn();
      allow create: if staff()
        && request.resource.data.instructorId == request.auth.uid;
      allow update: if staff()
        && (admin() || resource.data.instructorId == request.auth.uid)
        && request.resource.data.instructorId == resource.data.instructorId;
      allow delete: if admin();
    }

    match /users/{userId} {
      allow read: if admin() || (signedIn() && request.auth.uid == userId);
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
